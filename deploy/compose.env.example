# melon-hub 容器环境变量示例(compose.yaml env_file 引用)
# 复制为 compose.env 再修改;禁止把真实值 commit 入库

# ---------- 镜像 ----------
# 由离线包/镜像仓库发布时固定,默认 latest;本地构建时改成实际 tag
APP_IMAGE=melon-hub:latest

# ---------- 数据卷 ----------
# 容器内固定路径,不要改
MELON_DATA_DIR=/data

# ---------- 时区 ----------
# 应用内调度(schedule)用 zoneinfo,默认 Asia/Shanghai,一般不用动
MELON_TZ=Asia/Shanghai

# ---------- 浏览器后端 ----------
# playwright:容器内无头 Chromium,过 CF 托管挑战,采集完关闭不常驻 —— 生产默认
# webbridge:借宿主机 kimi-webbridge 扩展驱动真实 Chrome —— 仅本机开发用
MELON_BROWSER_BACKEND=playwright

# ---------- 数据库(MySQL 可选) ----------
# 不填或留 sqlite → 回退容器卷内 SQLite(MELON_DATA_DIR/melon.db)
# 填 mysql:// 则用外部 MySQL;生产推荐
#MELON_DB_URL=mysql://user:password@192.168.1.10:3306/melon_hub

# ---------- S3/RustFS(可选) ----------
# 不填 → 图片/正文对象写容器卷内 data/objects/
# 填后启用 S3 兼容对象存储;生产推荐
#MELON_S3_ENDPOINT=http://192.168.1.10:59100
#MELON_S3_BUCKET=melon-hub
#MELON_S3_ACCESS_KEY=changeme
#MELON_S3_SECRET_KEY=changeme
#MELON_S3_PUBLIC_BASE=http://192.168.1.10:59100/melon-hub

# ---------- 图片解密 ----------
# 三站 CDN 加密图片需要站内 image.*.js 才能解;本地把该 JS 内容粘到容器内文件里,
# 这里指向容器内路径;不配置则密文保留但面板会显式警告(2026-09-29 采集收尾协议)
# 示例:先 docker cp image.js melon-hub:/run/melon/image.js,再下面配:
#MELON_DECRYPT_JS=/run/melon/image.js
