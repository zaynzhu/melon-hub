# 复制为 .env 并填入真实值;.env 已被 .gitignore 排除,严禁提交

# ---- 对象存储(RustFS / S3 兼容)。不填时回退本地 data/objects/ ----
MELON_S3_ENDPOINT=
MELON_S3_BUCKET=
MELON_S3_ACCESS_KEY=
MELON_S3_SECRET_KEY=
# 桶的匿名读公网地址(如 http://host:port/bucket),前端图片直链使用
MELON_S3_PUBLIC_BASE=

# ---- 数据库。支持 mysql://user:pass@host:port/db(库不存在会自动创建);
#      不填时回退本地 SQLite data/melon.db ----
MELON_DB_URL=

# ---- 本地回退数据目录(默认 <项目>/data)。仅调试用 ----
MELON_DATA_DIR=
