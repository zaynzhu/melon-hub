# 复制为 .env 并填入真实值;.env 已被 .gitignore 排除,严禁提交

# ---- 对象存储(RustFS / S3 兼容)。不填时回退本地 data/objects/ ----
MELON_S3_ENDPOINT=
MELON_S3_BUCKET=
MELON_S3_ACCESS_KEY=
MELON_S3_SECRET_KEY=
MELON_S3_PUBLIC_BASE=

# ---- 数据库。不填时回退本地 SQLite data/melon.db ----
# 类型待定,当前实现仅支持 sqlite 回退;接入真实库时扩展 db 模块
MELON_DB_URL=

# ---- 本地回退数据目录(默认 <项目>/data)。仅调试用 ----
MELON_DATA_DIR=
